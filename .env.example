# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 Git에 올리지 않는다.

# OpenRouter 키 (없으면 챗봇이 규칙 기반 해석만 사용)
OPENROUTER_API_KEY=

# 무료 모델 ID (끝이 :free 인 모델)
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# 위 모델이 막혔을 때(429) 차례로 시도할 무료 모델. 비워 두면 기본값을 쓴다. 쓰지 않으려면 none
OPENROUTER_FALLBACK_MODELS=

# 한 사람이 하루에 AI 해석을 쓸 수 있는 횟수 (무료 키는 전체 하루 50회)
CHAT_AI_DAILY_LIMIT=15

# 이메일 인증용 메일 발송(Gmail 주소와 그 계정의 앱 비밀번호). 둘 다 넣으면 이메일 인증과 비밀번호 재설정이 켜진다
MAIL_USERNAME=
MAIL_PASSWORD=
# 1이면 메일 설정 없이도 인증을 켠다(코드는 터미널에 찍힘, 로컬 시험용). 0이면 메일 설정이 있어도 끈다
EMAIL_VERIFICATION=

# 1 로 두면 서버가 뜰 때 시연용 예시 모임이 모자랄 경우 스스로 채운다(배포 환경용, 비밀 값 아님)
SEED_DEMO=

# 아래 둘은 배포(Vercel)에서만 필요. 로컬에서는 비워 두면 자동 처리된다.
SECRET_KEY=
DATABASE_URL=
